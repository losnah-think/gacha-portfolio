# Source-review snapshot. Use a project and credentials that you own.
# No values below refer to the original deployed application.
APP_FIREBASE_PROJECT_ID=demo-gacha-showcase
PORT=8787
# Optional for a separately configured local Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Choose your own credential path or application-default credentials.
LOCAL_FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=
GEMINI_API_KEY=
CONTENT_SEED_CSV_PATH=
IMAGE_CDN_BASE_URL=https://example.invalid

# Toss integration is unconfigured. Obtain your own partner setup.
TOSS_API_BASE_URL=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_CERT_PATH=
TOSS_KEY_PATH=
# Alternatively use secure runtime-injected PEM values, never committed files.
TOSS_CERT_PEM=
TOSS_KEY_PEM=
TOSS_DECRYPTION_KEY=
TOSS_DECRYPTION_AAD=
TOSS_ENCRYPTION_KEY=
TOSS_ENCRYPTION_AAD=
TOSS_PROXY_URL=
USE_TEST_PROMOTION=true

AD_FULLSCREEN_ID=
AD_REWARD_ID=
AD_BANNER_GROUP_ID=
AD_BANNER_TEXT_GROUP_ID=
ADMIN_USER_IDS=
ENABLE_ACTIVITY_LOG_READS=false

# Per-promotion configuration names are documented in src/config/promotion.js.
# Without explicit configuration, their identifiers remain inert PLACEHOLDER_* values.
