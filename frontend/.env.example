# This browser bundle must never contain server credentials or private keys.
# Leave disabled for the standalone Vertex AI browser application.
VITE_ENABLE_RUNTIME=false

# Vercel server function configuration, never use a VITE_ prefix for these.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
VERTEX_SERVICE_ACCOUNT_JSON=

# Configure a backend you own. Defaults are local-only.
VITE_BACKEND_API_URL=http://127.0.0.1:8787
VITE_STORAGE_BASE_URL=/portfolio-assets
VITE_APP_URL=https://example.invalid

# Optional runtime integration: public Firebase web configuration for your own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MEASUREMENT_ID_2=
VITE_ENABLE_FIREBASE_ANALYTICS=false

# Optional provider integration: use only your own ad placement IDs.
VITE_REWARD_TICKET_AD_ID=
VITE_GACHA_REWARDED_AD_ID=
VITE_BANNER_AD_TEXT_ID=
VITE_BANNER_AD_IMAGE_ID=
VITE_HOME_TICKET_FULLSCREEN_AD_ID=
VITE_GACHA_QUICK_FULLSCREEN_AD_ID=
